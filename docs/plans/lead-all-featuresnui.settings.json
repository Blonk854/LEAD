// LEAD — all new features enabled + full profile set + preferred UI defaults
// This mirrors what ships in assets/settings/default.json for agent/UI prefs.
// For Hybrid worker hosts/models, replace PLACEHOLDER_* below (or configure
// in Settings → Network Agent). Those placeholders are NOT in the install
// default — only the feature switches and empty workers skeleton are.

{
  "auto_update": false,
  "title_bar": {
    "show_menus": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "icon_theme": "Zed (Default)",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "light",
    "light": "One Light",
    "dark": "One Dark"
  },

  "agent": {
    "enabled": true,
    "dock": "right",
    "default_profile": "hybrid",
    "favorite_models": [],
    "model_parameters": [],

    "default_model": {
      "provider": "lmstudio",
      "model": "PLACEHOLDER_LOCAL_WORKER_MODEL"
    },

    "network_agent": {
      "enabled": true,
      "model": "PLACEHOLDER_ORCHESTRATOR_MODEL",
      "delegation_mode": "balanced",
      "workers": {
        "scheduling": "least_busy",
        "max_workers": 10,
        "include_default_model": true,
        "endpoints": [
          {
            "id": "worker-lan-21",
            "provider": "worker-lan-21",
            "model": "PLACEHOLDER_MODEL_ON_WORKER_A",
            "max_concurrent": 1,
            "enabled": true
          },
          {
            "id": "worker-lan-22",
            "provider": "worker-lan-22",
            "model": "PLACEHOLDER_MODEL_ON_WORKER_B",
            "max_concurrent": 1,
            "enabled": true
          },
          {
            "id": "worker-lan-23",
            "provider": "worker-lan-23",
            "model": "PLACEHOLDER_MODEL_ON_WORKER_C",
            "max_concurrent": 1,
            "enabled": false
          }
        ]
      }
    },

    "full_access": {
      "enabled": true,
      "allowed_roots": [],
      "denied_roots": []
    },

    "auto_thread_rollover": {
      "enabled": true,
      "context_fraction": 0.6
    },

    "tool_permissions": {
      "default": "confirm"
    },

    "profiles": {
      "local-agent": {
        "name": "Local Agent",
        "enable_all_context_servers": false,
        "tools": {
